# Copy this file to `.env` and fill in your key.  `.env` is gitignored.
# Argus loads this automatically (argus/llm.py::load_dotenv).

# Required for the optimizer brain (--brain anthropic):
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the optimizer model (default: claude-opus-4-8)
# OPTIMIZER_MODEL=claude-opus-4-8
